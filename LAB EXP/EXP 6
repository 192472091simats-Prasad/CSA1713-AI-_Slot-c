# DFS function
def dfs(graph, node, visited):

    # Mark the current node as visited
    visited.add(node)

    # Display the current node
    print(node, end=" ")

    # Visit all adjacent nodes
    for neighbour in graph[node]:

        if neighbour not in visited:
            dfs(graph, neighbour, visited)


