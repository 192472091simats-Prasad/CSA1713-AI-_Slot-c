print("==============================================")


# Solve the problem
solution = solve_missionaries_cannibals()


# Display solution
if solution:

    print("\nSolution Found!")
    print("----------------------------------------------")

    for i, (state, move) in enumerate(solution):

        m_left, c_left, boat = state

        m_right = 3 - m_left
        c_right = 3 - c_left

        if boat == 0:
            boat_position = "Left"
        else:
            boat_position = "Right"

        print("\nStep", i)
        print("Move :", move)
        print("Left Bank  : Missionaries =", m_left,
              ", Cannibals =", c_left)
        print("Right Bank : Missionaries =", m_right,
              ", Cannibals =", c_right)
        print("Boat       :", boat_position)

    print("\n----------------------------------------------")
    print("All missionaries and cannibals")
    print("have been safely transported.")
    print("Missionaries and Cannibals Problem Solved!")
    print("----------------------------------------------")

else:

    print("\nNo solution exists.")
