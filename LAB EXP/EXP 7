from collections import deque


# Function to check whether a state is safe
def is_safe(m_left, c_left):

    m_right = 3 - m_left
    c_right = 3 - c_left

    # Check valid number of people
    if m_left < 0 or c_left < 0:
        return False

    if m_left > 3 or c_left > 3:
        return False

    # Check left bank
    if m_left > 0 and c_left > m_left:
        return False

    # Check right bank
    if m_right > 0 and c_right > m_right:
        return False

    return True


# Function to solve the problem
def solve_missionaries_cannibals():

    # Initial state:
    # 3 missionaries, 3 cannibals on left bank
    # Boat is on the left
    initial_state = (3, 3, 0)

    # Goal state:
    # Everyone is on the right bank
    goal_state = (0, 0, 1)

    # Queue for BFS
    queue = deque([initial_state])

    # Store visited states
    visited = set()

    # Store parent states
    parent = {}

    # Store the move used
    move_used = {}

    visited.add(initial_state)
    parent[initial_state] = None
    move_used[initial_state] = "Initial State"

    # Possible boat movements
    moves = [
        (1, 0, "1 Missionary"),
        (2, 0, "2 Missionaries"),
        (0, 1, "1 Cannibal"),
        (0, 2, "2 Cannibals"),
        (1, 1, "1 Missionary and 1 Cannibal")
    ]

    # BFS
    while queue:

        current = queue.popleft()

        m_left, c_left, boat = current

        # Check goal
        if current == goal_state:

            path = []
            state = current

            while state is not None:
                path.append(
                    (state, move_used[state])
                )
                state = parent[state]

            path.reverse()
            return path

        # Generate possible moves
        for m, c, description in moves:

            # Boat on left bank
            if boat == 0:

                new_m_left = m_left - m
                new_c_left = c_left - c
                new_boat = 1

            # Boat on right bank
            else:

                new_m_left = m_left + m
                new_c_left = c_left + c
                new_boat = 0

            new_state = (
                new_m_left,
                new_c_left,
                new_boat
            )

            # Check whether new state is safe
            if is_safe(new_m_left, new_c_left):

                if new_state not in visited:

                    visited.add(new_state)
                    queue.append(new_state)

                    parent[new_state] = current
                    move_used[new_state] = description

    return None


# ============================================================
# Main Program
# ============================================================

print("==============================================")
print("     MISSIONARIES AND CANNIBALS PROBLEM")
print("==============================================")
print("Name   : S DURGA PRASAD")
