# Function to count misplaced tiles
def count_misplaced_tiles(initial, goal):

    misplaced = 0

    # Compare each position
    for i in range(3):
        for j in range(3):

            # Ignore the blank tile (0)
            if initial[i][j] != 0 and initial[i][j] != goal[i][j]:
                misplaced += 1

    return misplaced


# Initial state
initial_state = [
    [1, 2, 3],
    [4, 0, 6],
    [7, 5, 8]
]

# Goal state
goal_state = [
    [1, 2, 3],
    [4, 5, 6],
    [7, 8, 0]
]


