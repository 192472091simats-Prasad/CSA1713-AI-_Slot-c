# A* Search Function
def a_star(graph, heuristic, start, goal):

    # Open list contains nodes to be explored
    open_list = [start]

    # Store the cost from start to each node
    g_cost = {start: 0}

    # Store the parent of each node
    parent = {start: None}

    while open_list:

        # Select node having the lowest f(n)
        current = min(
            open_list,
            key=lambda node: g_cost[node] + heuristic[node]
        )

        # Check whether goal is reached
        if current == goal:

            path = []
            node = current

            while node is not None:
                path.append(node)
                node = parent[node]

            path.reverse()

            return path, g_cost[goal]

        # Remove current node from open list
        open_list.remove(current)

        # Explore neighbours
        for neighbour, cost in graph[current]:

            new_g_cost = g_cost[current] + cost

            # If neighbour is not visited or cheaper path is found
            if neighbour not in g_cost or new_g_cost < g_cost[neighbour]:

                g_cost[neighbour] = new_g_cost
                parent[neighbour] = current

                if neighbour not in open_list:
                    open_list.append(neighbour)

    return None, None


