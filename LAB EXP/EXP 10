    node = input("Enter node name: ")
    graph[node] = []


# Enter number of edges
edges = int(input("\nEnter number of edges: "))


# Enter edges
print("\nEnter edges in the format:")
print("Source Destination Cost")

for i in range(edges):

    source = input("\nEnter source node: ")
    destination = input("Enter destination node: ")
    cost = int(input("Enter edge cost: "))

    # Add edge in both directions
    graph[source].append((destination, cost))
    graph[destination].append((source, cost))


# ------------------------------------------------------------
# Enter heuristic values
# ------------------------------------------------------------

heuristic = {}

print("\nEnter heuristic values:")

for node in graph:

    heuristic[node] = int(
        input("h(" + node + ") = ")
    )


# ------------------------------------------------------------
# Enter start and goal nodes
# ------------------------------------------------------------

start = input("\nEnter start node: ")
goal = input("Enter goal node: ")


# ------------------------------------------------------------
# Display graph
# ------------------------------------------------------------

print("\nGraph:")
print("----------------------------------------------")

for node in graph:

    print(node, "->", graph[node])


print("\nHeuristic Values:")
print("----------------------------------------------")

for node in heuristic:

    print("h(" + node + ") =", heuristic[node])


# ------------------------------------------------------------
# Perform A* Search
# ------------------------------------------------------------

path, cost = a_star(
    graph,
    heuristic,
    start,
    goal
)


# ------------------------------------------------------------
# Display Result
# ------------------------------------------------------------

if path:

    print("\n==============================================")
    print("             A* SEARCH RESULT")
    print("==============================================")

    print("Start Node :", start)
    print("Goal Node  :", goal)

    print("\nOptimal Path:")
    print("----------------------------------------------")

    print(" -> ".join(path))

    print("----------------------------------------------")
    print("Total Path Cost:", cost)

    print("----------------------------------------------")
    print("A* Search Completed Successfully.")

else:

    print("\nNo path exists between the given nodes.")
