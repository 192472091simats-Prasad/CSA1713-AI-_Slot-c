# Solve the 8-Queen problem
if solve(0):

    print("\nSolution:")
    print("--------------------------------------")

    for row in board:
        for cell in row:
            if cell == 1:
                print("Q", end=" ")
            else:
                print(".", end=" ")
        print()

    print("--------------------------------------")
    print("All 8 queens are placed safely.")
    print("No two queens attack each other.")

else:
    print("\nNo solution exists.")

