from collections import deque


# Function to solve the Water Jug Problem
def water_jug_problem(capacity1, capacity2, target):

    # Initial state: both jugs are empty
    initial_state = (0, 0)

    # Queue for BFS
    queue = deque([initial_state])

    # To store visited states
    visited = set()

    # To store the path
    parent = {}

    visited.add(initial_state)
    parent[initial_state] = None

    while queue:

        jug1, jug2 = queue.popleft()

        # Check whether target amount is obtained
        if jug1 == target or jug2 == target:

            path = []
            current = (jug1, jug2)

            while current is not None:
                path.append(current)
                current = parent[current]

            path.reverse()
            return path

        # Generate possible operations

        states = [
            ((capacity1, jug2), "Fill Jug 1"),
            ((jug1, capacity2), "Fill Jug 2"),
            ((0, jug2), "Empty Jug 1"),
            ((jug1, 0), "Empty Jug 2")
        ]

        # Transfer Jug 1 -> Jug 2
        amount = min(jug1, capacity2 - jug2)
        states.append(
            ((jug1 - amount, jug2 + amount),
             "Transfer Jug 1 -> Jug 2")
        )

        # Transfer Jug 2 -> Jug 1
        amount = min(jug2, capacity1 - jug1)
        states.append(
            ((jug1 + amount, jug2 - amount),
             "Transfer Jug 2 -> Jug 1")
        )

        # Add new states to queue
        for new_state, operation in states:

            if new_state not in visited:
                visited.add(new_state)
                queue.append(new_state)
                parent[new_state] = (jug1, jug2)

    return None


