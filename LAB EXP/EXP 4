# Initial room status
rooms = {
    "A": "Dirty",
    "B": "Dirty"
}


# Display status before cleaning
print("\nRoom Status Before Cleaning:")
print("--------------------------------------")
display_rooms(rooms)


# Run the vacuum cleaner
vacuum_cleaner(rooms)


# Display status after cleaning
print("Room Status After Cleaning:")
print("--------------------------------------")
display_rooms(rooms)

print("--------------------------------------")
print("All rooms are clean.")
print("Vacuum Cleaner Task Completed Successfully.")
