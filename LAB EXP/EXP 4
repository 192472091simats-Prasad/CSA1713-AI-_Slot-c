# Function to display room status
def display_rooms(rooms):
    print("Room A :", rooms["A"])
    print("Room B :", rooms["B"])


# Function for the vacuum cleaner agent
def vacuum_cleaner(rooms):

    print("\nCleaning Process:")
    print("--------------------------------------")

    # Visit each room
    for room in rooms:

        print("Vacuum Cleaner moves to Room", room)

        # Check whether the room is dirty
        if rooms[room] == "Dirty":

            print("Room", room, "is Dirty")
            print("Cleaning Room", room)

            # Clean the room
            rooms[room] = "Clean"

            print("Room", room, "is now Clean")

        else:
            print("Room", room, "is already Clean")

        print()


# ============================================================
# Main Program
# ============================================================

print("======================================")
print("       VACUUM CLEANER PROBLEM")
print("======================================")
print("Name   : S DURGA PRASAD")
